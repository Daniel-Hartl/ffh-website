<Window x:Class="FFH_Website_Manager.Popups.EditGalleryEvent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFH_Website_Manager.Popups"
        xmlns:model="clr-namespace:FFH_Website_Manager.Classes.Model.Gallery"
        mc:Ignorable="d"
        Title="Galerieordner bearbeiten" Height="450" Width="800"
         d:DataContext="{d:DesignInstance Type=model:GalleryTopic}"
        FontSize="14">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Label Content="Überschrift:"/>
        <TextBox Grid.Column="1" Text="{Binding Ordner}"/>

        <Label Content="Datum:" Grid.Row="1"/>
        <DatePicker Grid.Row="1" Grid.Column="1" Margin="5,5"
            Language="de-de"
            SelectedDate="{Binding DateInternal, UpdateSourceTrigger=PropertyChanged}"/>


        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" >
            <Separator Margin="5,5,5,0"/>
            <Separator Margin="5"/>
        </StackPanel>


        <Label Content="Bilder" FontWeight="Bold" Grid.ColumnSpan="2"
               HorizontalAlignment="Center" Grid.Row="3"/>
        <Label Content="Aktuelle Bilder:" Grid.Row="4"/>
        <ScrollViewer Grid.Row="4" Grid.Column="1" 
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Content}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Background="LightGray">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80px"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Bmp}" HorizontalAlignment="Center"
                                       MouseLeftButtonDown="OpenImage"/>
                                <Label Content="{Binding Converter={StaticResource uploadStateConverter}}"
                                       Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
                                <Button Content="🗑️" Click="DeleteImage" Grid.Column="1"
                                        ToolTip="Bild löschen"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="5"/>


        <Label Content="Gelöscht:" Grid.Row="6"
               ToolTip="Bilder, die bisher zu diesem Thema hinterlegt waren, mit Speichern des Vorgangs aber gelöscht werden."/>
        <ScrollViewer Grid.Row="6" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DeletedRemote}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Background="LightGray">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80px"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Bmp}" HorizontalAlignment="Center"
                                       MouseLeftButtonDown="OpenImage"/>
                                <Label Content="{Binding Converter={StaticResource uploadStateConverter}}"
                                       Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
                                <Button Content="↻" FontSize="25" FontWeight="Bold" Click="ReuseImage"  Grid.Column="1"
                                        ToolTip="Bild wiederherstellen"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Content="Bild(er) hinzufügen" Grid.Row="7" Grid.ColumnSpan="2" Click="AddImage"/>

        <DockPanel Grid.Row="8" Grid.ColumnSpan="2"
                   HorizontalAlignment="Right" Margin="0,5">
            <Button Content="Speichern" Click="SaveTopic"/>
            <Button Content="Zurücksetzen" Click="Reset" Margin="5,0" x:Name="resetBtn"/>
            <Button Content="Abbrechen" Click="Cancel"/>
        </DockPanel>
    </Grid>
</Window>
