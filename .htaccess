# Sicherheits- und Zugriffsregeln für FFH-Website

ErrorDocument 404 /index.html

# Verhindere Zugriff auf versteckte Dateien und Ordner
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Verhindere Zugriff auf sensible Ordner
RewriteEngine On
RewriteRule (^|/)(vendor|FFH-Website-Manager|\.git) - [F]

# Verhindere Zugriff auf Konfigurationsdateien
<FilesMatch "^(composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# PHP-Dateien erlauben
<FilesMatch "\.php$">
    Require all granted
</FilesMatch>

# HTML-Dateien erlauben
<FilesMatch "\.html$">
    Require all granted
</FilesMatch>

# CSS, JS, Bilder erlauben
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Require all granted
</FilesMatch>

# XML-Dateien erlauben (sitemap)
<FilesMatch "\.xml$">
    Require all granted
</FilesMatch>

DirectoryIndex index.html home.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options DENY
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 30
</IfModule>