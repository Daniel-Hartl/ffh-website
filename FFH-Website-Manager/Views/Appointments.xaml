<UserControl x:Class="FFH_Website_Manager.Views.Appointments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FFH_Website_Manager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:AppointmentViewModel x:Name="vm"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <CollectionViewSource x:Key="Groups" Source="{Binding Roles}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Appointments}" AutoGenerateColumns="False"
                  CanUserReorderColumns="False" Margin="10" Grid.Column="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Zeit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DateInternal, UpdateSourceTrigger=PropertyChanged}"
                                        Language="de-de" Margin="-1 -.5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Titel, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Treffpunkt" Binding="{Binding Ort, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridComboBoxColumn Header="Zielgruppe" SelectedValueBinding="{Binding Zielgruppe, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding Source={StaticResource Groups}}"/>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️" CommandParameter="{Binding}" Margin="-1 -.5"
                                    Command="{Binding ElementName=vm, Path=DeleteAppointmentCommand}"
                                    Style="{DynamicResource deleteButton}"
                                    Visibility="{Binding Converter={StaticResource visibilityConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel HorizontalAlignment="Right" Grid.Row="1"
                   Grid.Column="1" Margin="0 10" Grid.ColumnSpan="2">
            <Button Content="_Speichern" Margin="5,0" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding StateHasChanged}"/>
            <Button Content="_Zurücksetzen" Margin="5,0" Command="{Binding CancelCommand}"/>
        </DockPanel>
    </Grid>
</UserControl>
