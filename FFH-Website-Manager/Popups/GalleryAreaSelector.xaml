<Window x:Class="FFH_Website_Manager.Popups.GalleryAreaSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFH_Website_Manager.Popups"
        mc:Ignorable="d"
        Title="Wähle übergeordneten Bereich..." Width="300" Height="120"
        FontSize="14">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <DockPanel HorizontalAlignment="Center" Grid.Row="0">
            <RadioButton Content="Verein" Margin="0,0,10,20" x:Name="club"
                         GroupName="area"/>
            <RadioButton Content="Aktiv" Margin="10,0,0,20" x:Name="active"
                         GroupName="area"/>
        </DockPanel>
        <DockPanel HorizontalAlignment="Right" Grid.Row="1">
            <Button Content="Erstellen" Click="Save"/>
            <Button Content="Abbrechen" Click="Cancel"/>
        </DockPanel>
    </Grid>
</Window>
