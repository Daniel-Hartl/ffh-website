<UserControl x:Class="FFH_Website_Manager.Views.Gallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FFH_Website_Manager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="-3 10 -3 -3">
    <UserControl.DataContext>
        <local:GalleryViewModel x:Name="vm"/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TabControl ItemsSource="{Binding GalleryAreas}"
                    SelectionChanged="TabChanged" Style="{DynamicResource secondaryTabControl}"
                    ItemContainerStyle="{DynamicResource secondaryTabItem}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Ordner}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Inhalt}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding ElementName=vm, Path=EditEventCommand}"
                                            CommandParameter="{Binding}" Margin="5 5 0 0"
                                            Style="{DynamicResource secondaryButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="{Binding Ordner}" FontWeight="Bold"/>
                                            <Label Content="{Binding Datum}" Grid.Column="1"/>
                                        </Grid>
                                    </Button>
                                    <Button Content="🗑️" HorizontalAlignment="Left" Grid.Column="1"
                                            Command="{Binding ElementName=vm, Path=DeleteEventCommand}" 
                                            CommandParameter="{Binding}" Margin="0 5 5 0"
                                            Style="{DynamicResource deleteButton}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <Button Content="Neue Veranstaltung" Command="{Binding AddEventCommand}" 
                Grid.Row="1" Margin="10"/>
    </Grid>
</UserControl>
